{
  "edition": "intl",
  "gatewayId": "my-asr",
  "listen": { "host": null, "port": 8444 },
  "tls": "auto",
  "publicUrl": null,
  "dataDir": "/var/lib/pocket-asr",

  "auth": {
    "tokens": [],
    "ticket": {
      "enabled": false,
      "coordUrl": "https://pocket.pocketcli.net",
      "pinnedKeys": [ { "kid": "c1", "pub": "<the coordination public key>", "use": ["keys", "ticket", "revocations"], "nbf": 0, "exp": 0 } ],
      "accounts": ["<your Pocket account id>"]
    }
  },

  "engines": [
    { "id": "local", "type": "sherpa-onnx", "bin": "/opt/sherpa/bin/sherpa-onnx-offline", "model": "/var/lib/pocket-asr/models/sense-voice-int8", "threads": 2,
      "install": { "model": "sense-voice-int8" } },
    { "id": "openai", "type": "openai", "apiKey": "env:OPENAI_API_KEY", "model": "gpt-4o-transcribe" }
  ],
  "default": { "zh": "local", "en": "openai", "auto": "local" },

  "timezone": "Asia/Shanghai",
  "limits": { "maxBytes": 8388608, "maxSeconds": 240, "perMinute": 12, "concurrentPerCaller": 2, "concurrent": 2,
              "dayMinutes": 120, "monthMinutes": 1500 }
}
